# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000
# Set to true when running behind a reverse proxy / load balancer.
TRUST_PROXY=false
# Comma-separated allowed browser origins. Leave empty in development (all
# origins allowed); REQUIRED in production for the Flutter web build.
CORS_ORIGINS=

# Supabase → Project Settings → API. The service role key must stay on the server.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
# Encrypts medical free-text fields (AES-256-GCM). 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it safe: losing it makes those fields unreadable.
DATA_ENCRYPTION_KEY=
# Appointment / camp / eligibility reminders (runs every 15 min).
REMINDERS_ENABLED=true
REFRESH_TOKEN_TTL_DAYS=30
# Max attempts per IP per 15 minutes on login/register/verify/reset.
AUTH_RATE_LIMIT_MAX=10

# SMTP for one-time codes. If unset in development, codes are printed to the
# server log. Required in production.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Place search (OpenStreetMap Nominatim). Please set a contact email: the
# Nominatim usage policy requires an identifying User-Agent.
PLACES_BASE_URL=https://nominatim.openstreetmap.org
PLACES_COUNTRY_CODES=in
PLACES_CONTACT_EMAIL=
